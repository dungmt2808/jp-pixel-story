{
  "mcpServers": {
    "jp-pixel-studio": {
      "command": "uv",
      "args": [
        "--directory",
        "mcp-server",
        "run",
        "python",
        "server.py"
      ],
      "env": {
        "PYTHONPATH": ".",
        "VOICEVOX_URL": "http://127.0.0.1:50021"
      }
    }
  }
}
