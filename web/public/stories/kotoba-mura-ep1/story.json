          "talkClip": "talk"
        }
      },
      "labels": [
        {
          "text": "{宿帳|やどちょう}",
          "sub": "sổ đăng ký khách",
          "x": 74,
          "y": 64,
          "to": [
            74,
            98
          ],
          "afterLine": 2
        },
        {
          "text": "{囲炉裏|いろり}",
          "sub": "lò sưởi truyền thống",
          "x": 226,
          "y": 78,
          "to": [
            226,
            122
          ],
          "afterLine": 0
        }
      ],
      "lines": [
        {
          "id": "k02",
          "voice": "hana",
          "speakerLabel": "はなさん",
          "jaPlain": "リンさん、おはようございます。今日から「ことば屋」の仕事ですね。よろしくお願いします。",
          "jaRuby": "リンさん、おはようございます。{今日|きょう}から「ことば{屋|や}」の{仕事|しごと}ですね。よろしくお{願|ねが}いします。",
          "vi": "Chào buổi sáng Lin! Từ hôm nay em bắt đầu làm việc ở quán trọ Kotoba-ya nhé. Mong được đồng hành cùng em.",
          "action": "bow",
          "emote": "note",
          "audioUrl": "/stories/kotoba-mura-ep1/audio/k02.mp3",
          "durationSec": 8.661,
          "ttsHash": "cd0849589660"
        },
        {
          "id": "k03",
          "voice": "lin",
          "speakerLabel": "リンさん",
          "jaPlain": "おはようございます、はなさん！敬語も毎日練習しています！",
          "jaRuby": "おはようございます、はなさん！{敬語|けいご}も{毎日|まいにち}{練習|れんしゅう}しています！",
          "vi": "Em chào buổi sáng chị Hana! Em cũng luyện tập kính ngữ mỗi ngày ạ!",
          "action": "bow",
          "emote": "sparkle",
          "audioUrl": "/stories/kotoba-mura-ep1/audio/k03.mp3",
          "durationSec": 5.877,
          "ttsHash": "d0704fe0d4bc"
        },
        {
          "id": "k04",
          "voice": "hana",
          "speakerLabel": "はなさん",
          "jaPlain": "では、お客さまに宿帳へ名前を書いていただくとき、どう言いますか？",
          "jaRuby": "では、お{客|きゃく}さまに{宿帳|やどちょう}へ{名前|なまえ}を{書|か}いていただくとき、どう{言|い}いますか？",
          "vi": "Vậy khi mời khách viết tên vào sổ đăng ký, em sẽ nói thế nào nhỉ?",
          "action": "lean",
          "emote": "question",
          "camera": "push",
          "audioUrl": "/stories/kotoba-mura-ep1/audio/k04.mp3",
          "durationSec": 6.389,
          "ttsHash": "1b506ef32aa0"
        }
      ],
      "minigame": {
        "mode": "one",
        "autoPick": "okaki_kudasai",
        "prompt": "Chọn câu kính ngữ đúng để mời khách viết tên vào sổ",
        "choices": [
          {
            "id": "okaki_shimasu",
            "labelJa": "こちらにお名前をお書きします",
            "labelRuby": "こちらにお{名前|なまえ}をお{書|か}きします",
            "labelVi": "(Bẫy hay nhầm) Em xin phép viết tên ạ",
            "effect": "polite_bow",
            "responseLine": {
              "id": "k04_a",
              "voice": "hana",
              "speakerLabel": "はなさん",
              "jaPlain": "あら、「お書きします」は自分が書くときの言い方ですよ。お客さまには「お書きください」ですね。",
              "jaRuby": "あら、「お{書|か}きします」は{自分|じぶん}が{書|か}くときの{言|い}い{方|かた}ですよ。お{客|きゃく}さまには「お{書|か}きください」ですね。",
              "vi": "Ồ, 「お書きします」 là khi chính mình viết cơ. Mời khách viết phải nói là 「お書きください」 nhé em!",
              "action": "startle",
              "emote": "sweat",
              "telop": {
                "text": "お〜します ＝ {自分|じぶん}がする！",
                "sub": "Khiêm nhường ngữ (mình làm) ≠ mời khách",
                "color": "shu"
              },
              "audioUrl": "/stories/kotoba-mura-ep1/audio/k04_a.mp3",
              "durationSec": 9.248,
              "ttsHash": "7c5e5698a375"
            }
          },
          {
            "id": "okaki_kudasai",
            "labelJa": "こちらにお名前をお書きください",
            "labelRuby": "こちらにお{名前|なまえ}をお{書|か}きください",
            "labelVi": "Mời quý khách viết tên vào đây ạ",
            "effect": "polite_bow",
            "responseLine": {
              "id": "k04_b",
              "voice": "hana",
              "speakerLabel": "はなさん",
              "jaPlain": "そのとおり！とても丁寧で、いい敬語ですね。",
              "jaRuby": "そのとおり！とても{丁寧|ていねい}で、いい{敬語|けいご}ですね。",
              "vi": "Chính xác! Rất lịch sự, kính ngữ chuẩn lắm đó em!",
              "action": "bow",
              "emote": "sparkle",
              "camera": "punch",
              "telop": {
                "text": "お{書|か}きください！◎",
                "sub": "Tôn kính ngữ mời khách chuẩn xác!",
                "color": "gold"
              },
              "audioUrl": "/stories/kotoba-mura-ep1/audio/k04_b.mp3",
              "durationSec": 4.544,
              "ttsHash": "0ca0b7f7436b"
            }
          }
        ]
      },
      "actionLabel": "TIẾP TỤC →"
    },
