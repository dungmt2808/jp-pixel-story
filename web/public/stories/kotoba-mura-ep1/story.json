      "lines": [
        {
          "id": "k05",
          "voice": "stackchan",
          "speakerLabel": "スタックちゃん",
          "jaPlain": "リンさん、リンさん！大変だよ！ことば畑の芽が水を待っているよ！",
          "jaRuby": "リンさん、リンさん！{大変|たいへん}だよ！ことば{畑|はたけ}の{芽|め}が{水|みず}を{待|ま}っているよ！",
          "vi": "Chị Lin ơi, chị Lin ơi! Nguy rồi! Mấy mầm cây ngoài vườn Kotoba đang chờ tưới nước đấy!",
          "emote": "sparkle",
          "emoteWho": "stackchan",
          "camera": "punch",
          "audioUrl": "/stories/kotoba-mura-ep1/audio/k05.mp3",
          "durationSec": 6.08,
          "ttsHash": "8c5dabede51f"
        },
        {
          "id": "k06",
          "voice": "lin",
          "speakerLabel": "リンさん",
          "jaPlain": "わっ、スタックちゃん！そんなに走ると、また電池が減ってしまいますよ！",
          "jaRuby": "わっ、スタックちゃん！そんなに{走|はし}ると、また{電池|でんち}が{減|へ}ってしまいますよ！",
          "vi": "Á, Stack-chan! Chạy nhanh như thế là pin lại tụt hết mất đấy!",
          "emote": "shock",
          "emoteWho": "lin",
          "audioUrl": "/stories/kotoba-mura-ep1/audio/k06.mp3",
          "durationSec": 6.443,
          "ttsHash": "9ecb7999af4d"
        },
        {
          "id": "k07",
          "voice": "stackchan",
          "speakerLabel": "スタックちゃん",
          "jaPlain": "ぼくは大丈夫！早くいっしょに見に行こう！",
          "jaRuby": "ぼくは{大丈夫|だいじょうぶ}！{早|はや}くいっしょに{見|み}に{行|い}こう！",
          "vi": "Tớ không sao đâu! Mau cùng ra xem đi nào!",
          "emote": "note",
          "emoteWho": "stackchan",
          "audioUrl": "/stories/kotoba-mura-ep1/audio/k07.mp3",
          "durationSec": 3.477,
          "ttsHash": "5b784e30ae31"
        }
      ],
